#!/usr/bin/env bash
# The local gate: formatting, lints, tests, a seed sweep, and the Node
# binding's tests.
#
#     scripts/check [SEEDS]
set -euo pipefail
cd "$(dirname "$0")/.."
seeds="${1:-1000}"
cargo fmt --all --check
cargo clippy --workspace --all-targets -- -D warnings
cargo test --workspace --release
cargo run --release -p sqlive-sim -- 0 --seeds "$seeds"
(
  cd crates/node
  node scripts/build.mjs --profile release
  node --test test/*.test.mjs
  node scripts/release.mjs check
  node --test scripts/*.test.mjs
)
