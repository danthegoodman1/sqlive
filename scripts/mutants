#!/usr/bin/env python3
"""Plants known bugs, one at a time, in a scratch copy of the workspace and
reports which layer catches each: the library's unit tests, the simulator's
tests (scenarios and regression seeds), the chat example's tests, or a seed
sweep.

    scripts/mutants [--seeds N] [--only NAME]... [--check] [--no-baseline]

A mutant is a list of replacements; each must match exactly once, ignoring
whitespace, so formatting changes leave the mutants intact. The copy lives
in target/mutants/src and shares one target directory: dependencies build
once, and every workspace crate rebuilds for each mutant. First the
unmutated code runs every layer, since a layer that fails without a mutant
would claim to catch them all. A step that hangs counts as a catch, and is
killed with every process it started. Exits non-zero if the unmutated code
fails, or any mutant goes uncaught or fails to build.
"""

import argparse
import os
import re
import shutil
import signal
import subprocess
import sys
from pathlib import Path

PRNG = "crates/sim/src/prng.rs"
VFS = "crates/sim/src/vfs.rs"
